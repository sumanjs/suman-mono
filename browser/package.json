{
  "name": "suman-browser",
  "version": "0.0.101",
  "description": "A Webpack build of the Suman module, for use with RequireJS, SystemJS and Browserify, etc.",
  "typings": "index.d.ts",
  "types": "index.d.ts",
  "main": "index.js",
  "scripts": {
    "test": "suman",
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/sumanjs/suman-browser.git"
  },
  "keywords": [
    "sumanjs",
    "browser",
    "testing",
    "unit",
    "testing",
    "tdd"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-browser/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-browser#readme",
  "dependencies": {
    "async": "^2.6.4",
    "chrome-launcher": "^1.2.1",
    "lodash": "^4.18.1",
    "puppeteer": "^25.4.0",
    "replacestream": "^4.0.3",
    "suman-utils": "latest",
    "webpack": "^5.109.2",
    "webpack-stream": "^7.0.0"
  },
  "devDependencies": {
    "@types/async": "^2.0.49",
    "@types/core-js": "^0.9.43",
    "@types/lodash": "^4.14.116",
    "@types/node": "^8.0.47",
    "node-polyfill-webpack-plugin": "^4.1.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
