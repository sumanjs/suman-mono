{
  "name": "suman-interactive",
  "version": "0.0.1002",
  "description": "Suman interactive project to guide users through advanced use cases",
  "main": "lib/index.js",
  "scripts": {
    "test": "suman test",
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman-interactive.git"
  },
  "keywords": [
    "suman",
    "sumanjs",
    "testing",
    "interactive",
    "inquirer",
    "inquirer-directory",
    "command",
    "command-line",
    "cli",
    "interactive-cli"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-interactive/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-interactive#readme",
  "dependencies": {
    "async": "^2.6.1",
    "suman-inquirer": "latest",
    "suman-inquirer-directory": "latest",
    "suman-utils": "latest"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
