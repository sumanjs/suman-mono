{
  "name": "suman-transform-plugins",
  "version": "0.0.106",
  "description": "Plugins for transforming source code to target code.",
  "main": "lib/index.js",
  "scripts": {
    "test": "suman test",
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman-transform-plugins.git"
  },
  "keywords": [
    "suman",
    "testing",
    "transform",
    "transpile",
    "compile",
    "plugins",
    "sumanjs"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-transform-plugins/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-transform-plugins#readme",
  "devDependencies": {
    "@types/node": "^10.11.3"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
