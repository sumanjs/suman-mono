{
  "name": "suman-types",
  "version": "0.0.1009",
  "description": "TypeScript type declarations for various SumanJS projects.",
  "typings": "dts/**/*.ts",
  "types": "dts/**/*.ts",
  "scripts": {
    "test": "suman test",
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman-types.git"
  },
  "keywords": [
    "suman",
    "sumanjs",
    "test",
    "typings",
    "tsc",
    "types",
    "typescript"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-types/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-types#readme",
  "dependencies": {},
  "devDependencies": {
    "@types/async": "^2.0.44",
    "@types/chai": "^4.0.7",
    "@types/node": "^8.0.28",
    "@types/socket.io-client": "^1.4.31",
    "chai": "^4.1.2",
    "rxjs": "^5.4.3",
    "typescript-json-schema": "^0.20.0"
  },
  "npp": {
    "publishable": true
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
