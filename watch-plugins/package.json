{
  "name": "suman-watch-plugins",
  "version": "0.0.102",
  "description": "Plugins to be used with suman-watch utilities.",
  "main": "index.js",
  "scripts": {
    "test": "./scripts/test.sh",
    "lint:ores": "if [ -f ../.ores-lint/lint.sh ]; then sh ../.ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sumanjs/suman-watch-plugins.git"
  },
  "keywords": [
    "sumanjs",
    "suman",
    "watch",
    "testing",
    "dx",
    "dev-ex",
    "developer-experience"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sumanjs/suman-watch-plugins/issues"
  },
  "homepage": "https://github.com/sumanjs/suman-watch-plugins#readme",
  "dependencies": {
    "chalk": "^2.3.0",
    "semver": "^5.4.1",
    "suman-utils": "latest"
  },
  "devDependencies": {
    "@types/core-js": "^0.9.43",
    "@types/node": "^8.0.47"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
